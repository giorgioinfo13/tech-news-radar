# Copy to .env at the repository root. All values below are public examples.
TNR_APP_NAME="Tech News Radar"
TNR_DOCS_ENABLED=true

# Relative SQLite paths resolve from backend/, regardless of the working directory.
TNR_DATABASE_URL=sqlite:///data/news.db

# Optional PostgreSQL (backend only). Replace placeholders in private configuration.
# Session pooler on port 5432; transaction pooling is not supported.
# Percent-encode the password and certificate path. Obtain the CA from Supabase.
# TNR_DATABASE_URL=postgresql+psycopg://tnr_app.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=verify-full&sslrootcert=/absolute/path/to/ca.crt
# Optional migration owner URL. Alembic falls back to TNR_DATABASE_URL when unset.
# TNR_MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:ENCODED_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=verify-full&sslrootcert=/absolute/path/to/ca.crt
# See docs/postgresql.md before using a remote database. No automatic migrations.

# One backend process only. Each source defaults to a 60-minute refresh interval.
TNR_SCHEDULER_ENABLED=true
TNR_SCHEDULER_POLL_SECONDS=30

# Collection limits. HTTP timeout is per operation; DNS uses the OS resolver.
TNR_FEED_TIMEOUT_SECONDS=10
TNR_FEED_MAX_BYTES=2000000
TNR_FEED_MAX_ENTRIES=5000

# Used only by the Vite development proxy. Never put credentials in this URL.
TNR_API_TARGET=http://127.0.0.1:8000
