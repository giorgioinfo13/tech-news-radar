# Copy to .env at the repository root. All values below are public examples.
TNR_APP_NAME="Tech News Radar"
TNR_DOCS_ENABLED=true

# Relative SQLite paths resolve from backend/, regardless of the working directory.
TNR_DATABASE_URL=sqlite:///data/news.db

# One backend process only. Each source defaults to a 60-minute refresh interval.
TNR_SCHEDULER_ENABLED=true
TNR_SCHEDULER_POLL_SECONDS=30

# Collection limits. HTTP timeout is per operation; DNS uses the OS resolver.
TNR_FEED_TIMEOUT_SECONDS=10
TNR_FEED_MAX_BYTES=2000000
TNR_FEED_MAX_ENTRIES=5000

# Used only by the Vite development proxy. Never put credentials in this URL.
TNR_API_TARGET=http://127.0.0.1:8000
