# Copy to .env at the repository root. All values below are public examples.
TNR_APP_NAME="Tech News Radar"
TNR_ENVIRONMENT=development
TNR_DOCS_ENABLED=true

# LOCAL DEVELOPMENT ONLY: uncomment to use the reserved owner after migration 0003.
# This is not login. Never enable it on Render or any public/proxied deployment.
# Without an identity provider or this local setting, data endpoints return 401.
# TNR_LOCAL_USER_ID=00000000-0000-0000-0000-000000000001

# Supabase access-token verification. Mutually exclusive with local identity.
# Requires ES256/RS256 signing keys and explicitly approved user UUIDs.
# No Auth secret or service-role key is needed. See docs/authentication.md.
# TNR_SUPABASE_URL=https://PROJECT_REF.supabase.co

# Frontend public configuration, for the same Supabase project as the backend.
# These values are included in browser assets. Never use secret/service-role keys.
# VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_PUBLIC_KEY

# LOCAL DEVELOPMENT ONLY: pair with TNR_LOCAL_USER_ID and omit Supabase settings.
# This bypass is accepted only by the Vite dev server on a loopback hostname.
# VITE_LOCAL_MODE=true

# Relative SQLite paths resolve from backend/, regardless of the working directory.
TNR_DATABASE_URL=sqlite:///data/news.db

# Optional PostgreSQL (backend only). Replace placeholders in private configuration.
# Session pooler on port 5432; transaction pooling is not supported.
# Percent-encode the password and certificate path. Obtain the CA from Supabase.
# TNR_DATABASE_URL=postgresql+psycopg://tnr_app.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=verify-full&sslrootcert=/absolute/path/to/ca.crt
# Optional operator URL for migrations and access provisioning. Both fall back to TNR_DATABASE_URL when unset.
# TNR_MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:ENCODED_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=verify-full&sslrootcert=/absolute/path/to/ca.crt
# See docs/postgresql.md before using a remote database. No automatic migrations.

# One backend process only. Each source defaults to a 60-minute refresh interval.
TNR_SCHEDULER_ENABLED=true
TNR_SCHEDULER_POLL_SECONDS=30

# Optional external trigger for a sleeping backend. Leave unset for local development.
# Requires TNR_SCHEDULER_ENABLED=false. Generate a private random secret; never use VITE_*.
# TNR_COLLECTION_TRIGGER_SECRET=REPLACE_WITH_A_RANDOM_URL_SAFE_SECRET
# See docs/development.md for GitHub Actions activation after deployment.

# Collection limits. HTTP timeout is per operation; DNS uses the OS resolver.
TNR_FEED_TIMEOUT_SECONDS=10
TNR_FEED_MAX_BYTES=2000000
TNR_FEED_MAX_ENTRIES=5000

# Used only by the Vite development proxy. Never put credentials in this URL.
TNR_API_TARGET=http://127.0.0.1:8000
